{
  "name": "cs-switch",
  "version": "0.0.5",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "cs-switch": "src/cli.mjs"
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "check:version": "node scripts/check-version.mjs",
    "version:next": "node scripts/bump-version.mjs",
    "test:protocol": "node --test tests/protocol.test.mjs tests/gateway.test.mjs tests/server-tools.test.mjs",
    "test:update": "node --test tests/releases.test.mjs tests/update.test.mjs",
    "test:workbench": "node --test tests/connection.test.mjs tests/workbench.test.mjs tests/application.test.mjs tests/version.test.mjs tests/readiness.test.mjs tests/quality.test.mjs",
    "start": "node src/cli.mjs serve"
  },
  "dependencies": {
    "acorn": "8.19.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "cheerio": "1.2.0",
    "ipaddr.js": "2.5.0",
    "pdfjs-dist": "6.4.299",
    "tar": "7.5.22",
    "undici": "8.11.2"
  }
}
